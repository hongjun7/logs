---
layout: none
---
{% assign articles = site.posts %}
[{% for post in articles %}{% capture topic_text %}{% for tag in post.tags %}{% include snippets/note-topic.html slug=tag %}{% unless forloop.last %}{{ ' ' }}{% endunless %}{% endfor %}{% endcapture %}{"title":{{ post.title | jsonify }},"url":{{ post.url | relative_url | jsonify }},"date":{{ post.date | date: '%B %-d, %Y' | jsonify }},"tags":{{ post.tags | jsonify }},"topic_text":{{ topic_text | jsonify }},"description":{{ post.subtitle | jsonify }},"content":{{ post.content | strip_html | normalize_whitespace | jsonify }}}{% unless forloop.last %},{% endunless %}{% endfor %}]
